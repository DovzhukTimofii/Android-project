<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MauiStartup.ViewModels"
    x:Class="MauiStartup.MainPage"
    x:DataType="viewmodel:MainPageModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Перевірка реєстрації"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Введіть електронну пошту та пароль"
                FontSize="16"
                HorizontalOptions="Center" />

            <Entry
                Placeholder="Електронна пошта"
                Keyboard="Email"
                Text="{Binding Email}" />

            <Entry
                Placeholder="Пароль"
                IsPassword="True"
                Text="{Binding Password}" />

            <Button
                Text="Перевірити реєстрацію"
                Command="{Binding CheckRegistrationCommand}" />

            <Label
                Text="{Binding Message}"
                FontSize="18"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>