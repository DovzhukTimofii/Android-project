<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiStartup.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MauiStartup.ViewModels"
    x:DataType="viewmodel:ProfilePageModel"
    Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="{Binding PageTitle}" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />

            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Image Source="{Binding PictureUrl}" HeightRequest="110" WidthRequest="110" Aspect="AspectFill" HorizontalOptions="Center" IsVisible="{Binding IsAuthenticated}" />
                    <Label Text="{Binding UserName}" FontSize="23" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="{Binding IsAuthenticated}" />
                    <Label Text="{Binding UserEmail}" FontSize="15" HorizontalTextAlignment="Center" IsVisible="{Binding IsAuthenticated}" />
                    <Label Text="{Binding StatusText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding FavoritesText}" FontSize="16" />
                    <Label Text="{Binding CreatedMoviesText}" FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding LanguageLabel}" FontSize="18" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

            <Button Text="{Binding SignOutText}" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
