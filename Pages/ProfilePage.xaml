<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiStartup.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профіль">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Профіль користувача"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            x:Name="StatusLabel"
            FontSize="18"
            HorizontalTextAlignment="Center" />

        <Label
            x:Name="EmailLabel"
            FontSize="18"
            HorizontalTextAlignment="Center"
            IsVisible="False" />

    </VerticalStackLayout>

</ContentPage>