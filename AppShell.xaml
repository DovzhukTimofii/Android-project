<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiStartup.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiStartup"
    xmlns:pages="clr-namespace:MauiStartup.Pages"
    Title="Movie Catalog"
    FlyoutBehavior="Flyout">

    <ShellContent x:Name="HomeItem" Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    <ShellContent x:Name="ProfileItem" Title="Profile" ContentTemplate="{DataTemplate pages:ProfilePage}" Route="ProfilePage" />
    <ShellContent x:Name="MoviesItem" Title="Movies" ContentTemplate="{DataTemplate pages:MoviesPage}" Route="MoviesPage" />
</Shell>
